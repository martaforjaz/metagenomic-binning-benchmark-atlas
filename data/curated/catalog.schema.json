      },
      "family_id": {
        "type": "string"
      },
      "release": {
        "type": "string"
      },
      "subset": {
        "type": "string"
      },
      "origin": {
        "type": "string"
      },
      "technology": {
        "type": "string"
      },
      "environment": {
        "type": "string"
      },
      "sample_count": {
        "type": [
          "number",
          "string"
