        "type": "string"
      },
      "data_size_gbp": {
        "type": [
          "number",
          "string"
        ]
      },
      "assembly_id": {
        "type": "string"
      },
      "ground_truth_status": {
        "type": "string"
      },
      "access_status": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "evidence_status": {
        "type": "string"
      },
      "accessions": {
        "type": "string"
      }
