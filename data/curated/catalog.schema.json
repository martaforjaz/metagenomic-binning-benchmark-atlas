{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical dataset subset catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "dataset_id",
      "family_id",
      "release",
      "subset",
      "origin",
      "technology",
      "environment",
      "sample_count",
